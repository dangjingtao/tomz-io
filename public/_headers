/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/*/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Machine consumers poll a versioned, static Book index.
# Cross-origin allow-origin is already supplied by the site's Cloudflare rule;
# avoid duplicating Access-Control-Allow-Origin, which could invalidate CORS.
/books/catalog.json
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Expose-Headers: ETag, Last-Modified

# Keep publication resources fresh, expose CDN validators to cross-origin readers.
# CORS allow-origin is already managed by Cloudflare; do not duplicate it.
/rss.xml
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Expose-Headers: ETag, Last-Modified

/feed.json
  Content-Type: application/feed+json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Expose-Headers: ETag, Last-Modified

/feeds.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Expose-Headers: ETag, Last-Modified
